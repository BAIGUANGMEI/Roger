<Window x:Class="Roger.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Roger.Views" Title="Roger · 电脑状态，一眼掌握" Icon="Assets/Roger.ico" Width="1220" Height="830" MinWidth="1020" MinHeight="720" Background="{StaticResource Bg}" Foreground="#E9EFF6" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" TextOptions.TextFormattingMode="Display" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResizeWithGrip" Loaded="Window_Loaded" Closing="Window_Closing">
  <Window.Resources><Style x:Key="PageHeading" TargetType="TextBlock"><Setter Property="FontSize" Value="26"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,8"/></Style></Window.Resources>
  <Border BorderBrush="#303B48" BorderThickness="1">
  <Grid><Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="204"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.ColumnSpan="2" Background="#11171F" MouseLeftButtonDown="TitleBar_MouseDown"><Grid Margin="18,0,6,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="◈" Foreground="{StaticResource Accent}" FontSize="21" Margin="0,0,10,0"/><TextBlock Text="Roger" FontWeight="SemiBold" FontSize="15"/><TextBlock Text=" /  YOUR PC, IN FOCUS" FontSize="10" Foreground="#617085" Margin="16,4,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="—" Click="Minimize_Click" BorderThickness="0" Background="Transparent" Padding="16,6" AutomationProperties.Name="最小化"/><Button Content="□" Click="Maximize_Click" BorderThickness="0" Background="Transparent" Padding="16,6" AutomationProperties.Name="最大化"/><Button Content="✕" Click="Close_Click" BorderThickness="0" Background="Transparent" Padding="16,6" ToolTip="根据设置关闭到托盘" AutomationProperties.Name="关闭"/></StackPanel></Grid></Border>
    <Border Grid.Row="1" Background="#11171F" BorderBrush="#26313D" BorderThickness="0,0,1,0"><DockPanel>
      <StackPanel DockPanel.Dock="Top" Margin="0,24,0,0"><TextBlock Text="工作空间" Style="{StaticResource MutedText}" Margin="27,0,0,14"/>
        <RadioButton x:Name="NavOverview" Content="◫     运行概览" Tag="overview" GroupName="Nav" Style="{StaticResource Nav}" Checked="Navigate_Checked" IsChecked="True"/>
        <RadioButton Content="▣     硬件与传感器" Tag="hardware" GroupName="Nav" Style="{StaticResource Nav}" Checked="Navigate_Checked"/>
        <RadioButton Content="▤     磁盘空间" Tag="disk" GroupName="Nav" Style="{StaticResource Nav}" Checked="Navigate_Checked"/>
        <RadioButton Content="⇅     网络测速" Tag="network" GroupName="Nav" Style="{StaticResource Nav}" Checked="Navigate_Checked"/>
        <Border Height="1" Background="#26313D" Margin="26,20"/>
        <RadioButton Content="⚙     偏好设置" Tag="settings" GroupName="Nav" Style="{StaticResource Nav}" Checked="Navigate_Checked"/>
        <RadioButton Content="↻     版本与更新" Tag="updates" GroupName="Nav" Style="{StaticResource Nav}" Checked="Navigate_Checked"/>
      </StackPanel>
      <StackPanel DockPanel.Dock="Bottom" Margin="22,0,22,22"><Border Background="#172820" BorderBrush="#284537" BorderThickness="1" CornerRadius="8" Padding="12"><StackPanel><TextBlock Text="●  实时监控" Foreground="{StaticResource Accent}" FontSize="12"/><TextBlock x:Name="SidebarInterval" Text="每 2 秒采样一次" Style="{StaticResource MutedText}" Margin="0,7,0,0"/></StackPanel></Border><TextBlock x:Name="SidebarVersion" Text="ROGER / v0.1.0" Foreground="#596B7D" FontSize="10" Margin="2,17,0,0"/></StackPanel>
      <Grid/>
    </DockPanel></Border>
    <Grid Grid.Row="1" Grid.Column="1" Margin="28,26,28,18">
      <ScrollViewer x:Name="OverviewPage"><StackPanel>
        <Grid Margin="0,0,0,23"><StackPanel><TextBlock Text="运行概览" Style="{StaticResource PageHeading}"/><TextBlock Text="了解此刻的电脑，让每一份性能都有迹可循。" Foreground="{StaticResource Muted}"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#172820" CornerRadius="15" Padding="12,7"><TextBlock Text="●  LIVE" Foreground="{StaticResource Accent}" FontSize="11"/></Border></Grid>
        <UniformGrid Columns="4" Margin="-5,0,-5,18">
          <Border Style="{StaticResource Card}" Margin="5,0"><StackPanel><TextBlock Text="CPU / 处理器" Foreground="#9EACBF" FontSize="11"/><TextBlock x:Name="CpuValue" Text="—" FontSize="34" FontWeight="SemiBold" Margin="0,12,0,9" Foreground="{StaticResource Accent}"/><ProgressBar x:Name="CpuProgress"/><TextBlock x:Name="CpuDetail" Text="温度 等待采样" Style="{StaticResource MutedText}" Margin="0,13,0,0"/></StackPanel></Border>
          <Border Style="{StaticResource Card}" Margin="5,0"><StackPanel><TextBlock Text="GPU / 图形处理器" Foreground="#9EACBF" FontSize="11"/><TextBlock x:Name="GpuValue" Text="—" FontSize="34" FontWeight="SemiBold" Margin="0,12,0,9" Foreground="#B6A8FF"/><ProgressBar x:Name="GpuProgress" Foreground="#AB98F8"/><TextBlock x:Name="GpuDetail" Text="温度 等待采样" Style="{StaticResource MutedText}" Margin="0,13,0,0"/></StackPanel></Border>
          <Border Style="{StaticResource Card}" Margin="5,0"><StackPanel><TextBlock Text="RAM / 内存" Foreground="#9EACBF" FontSize="11"/><TextBlock x:Name="MemoryValue" Text="—" FontSize="34" FontWeight="SemiBold" Margin="0,12,0,9" Foreground="#83BFF4"/><ProgressBar x:Name="MemoryProgress" Foreground="#69B7F3"/><TextBlock x:Name="MemoryDetail" Text="等待采样" Style="{StaticResource MutedText}" Margin="0,13,0,0"/></StackPanel></Border>
          <Border Style="{StaticResource Card}" Margin="5,0"><StackPanel><TextBlock Text="NETWORK / 当前流量" Foreground="#9EACBF" FontSize="11"/><TextBlock x:Name="DownloadValue" Text="—" FontSize="25" FontWeight="SemiBold" Margin="0,17,0,12" Foreground="#E8C98D"/><TextBlock x:Name="UploadValue" Text="↑ 等待采样" Foreground="#E8C98D" FontSize="12"/><TextBlock x:Name="NetworkDetail" Text="本机活动网卡" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" MaxHeight="18" Margin="0,13,0,0"/></StackPanel></Border>
        </UniformGrid>
        <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="1.65*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource Card}"><StackPanel><Grid><TextBlock Text="性能趋势" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="ChartSpan" Text="最近 60 次采样 · %" HorizontalAlignment="Right" Style="{StaticResource MutedText}"/></Grid><views:HistoryChart x:Name="PerformanceChart" Height="168" Margin="0,24,0,6"/><StackPanel Orientation="Horizontal"><TextBlock Text="● CPU" Foreground="{StaticResource Accent}" FontSize="11" Margin="0,0,20,0"/><TextBlock Text="● GPU" Foreground="#AB98F8" FontSize="11" Margin="0,0,20,0"/><TextBlock Text="● 内存" Foreground="#69B7F3" FontSize="11"/></StackPanel></StackPanel></Border>
          <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="这台电脑" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="MachineName" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,7"/><TextBlock x:Name="MachineOs" Style="{StaticResource MutedText}"/><Border Height="1" Background="{StaticResource Line}" Margin="0,15"/><TextBlock Text="处理器" FontSize="10" Foreground="#6F839A"/><TextBlock x:Name="CpuName" Text="正在识别硬件…" FontSize="12" Margin="0,5,0,11"/><TextBlock Text="显卡" FontSize="10" Foreground="#6F839A"/><TextBlock x:Name="GpuName" Text="正在识别硬件…" FontSize="12" Margin="0,5,0,0"/></StackPanel></Border>
        </Grid>
        <Border Style="{StaticResource Card}"><StackPanel><Grid><TextBlock Text="存储空间" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="已用 / 总容量" HorizontalAlignment="Right" Style="{StaticResource MutedText}"/></Grid><StackPanel x:Name="DriveCards" Margin="0,10,0,0"/></StackPanel></Border>
        <TextBlock x:Name="SensorNotice" Text="正在初始化传感器…" Foreground="#8595A8" FontSize="11" Margin="0,14,0,0"/>
      </StackPanel></ScrollViewer>
      <ScrollViewer x:Name="HardwarePage" Visibility="Collapsed"><StackPanel><TextBlock Text="硬件与传感器" Style="{StaticResource PageHeading}"/><TextBlock Text="设备配置与可读取的温度、风扇、频率和负载。缺失数据不会以 0 代替。" Foreground="{StaticResource Muted}" Margin="0,0,0,24"/>
        <TextBlock Text="设备配置" FontSize="16" Margin="0,0,0,12"/><DataGrid x:Name="HardwareGrid" Height="260"><DataGrid.Columns><DataGridTextColumn Header="类型" Binding="{Binding Category}" Width="100"/><DataGridTextColumn Header="设备" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="详细信息" Binding="{Binding Details}" Width="2*"/></DataGrid.Columns></DataGrid>
        <TextBlock Text="实时传感器" FontSize="16" Margin="0,26,0,12"/><DataGrid x:Name="SensorGrid" Height="290"><DataGrid.Columns><DataGridTextColumn Header="硬件" Binding="{Binding Hardware}" Width="2*"/><DataGridTextColumn Header="传感器" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="*"/><DataGridTextColumn Header="值" Binding="{Binding Value, StringFormat=F1}" Width="80"/><DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="65"/></DataGrid.Columns></DataGrid>
        <TextBlock Text="部分温度、主板与风扇传感器需要以管理员身份启动；支持程度取决于硬件和驱动。" Style="{StaticResource MutedText}" Margin="0,16,0,0"/>
      </StackPanel></ScrollViewer>
      <ScrollViewer x:Name="DiskPage" Visibility="Collapsed"><StackPanel><TextBlock Text="磁盘空间" Style="{StaticResource PageHeading}"/><TextBlock Text="找到空间都去了哪里。只读扫描，不删除或移动文件。" Foreground="{StaticResource Muted}" Margin="0,0,0,24"/>
        <Border Style="{StaticResource Card}"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ScanPath" AutomationProperties.Name="扫描路径"/><Button Grid.Column="1" Content="选择文件夹" Click="ChooseFolder_Click" Margin="8,0"/><Button x:Name="ScanButton" Grid.Column="2" Content="开始分析" Style="{StaticResource Primary}" Click="Scan_Click"/><Button x:Name="CancelScanButton" Grid.Column="3" Content="取消" Click="CancelScan_Click" IsEnabled="False" Margin="8,0,0,0"/></Grid><ProgressBar x:Name="ScanProgress" Margin="0,17,0,12"/><TextBlock x:Name="ScanStatus" Text="选择文件夹或输入磁盘路径，例如 C:\。" Foreground="{StaticResource Muted}"/><TextBlock x:Name="ScanCurrent" Foreground="#6D8197" FontSize="11" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" MaxHeight="18"/></StackPanel></Border>
        <TextBlock Text="空间分布 / 一级目录" FontSize="16" Margin="0,24,0,12"/><StackPanel x:Name="DiskBars"/>
        <TextBlock Text="大文件 / TOP 100" FontSize="16" Margin="0,24,0,12"/><DataGrid x:Name="FilesGrid" Height="235" MouseDoubleClick="FilesGrid_DoubleClick"><DataGrid.Columns><DataGridTextColumn Header="文件名" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="大小" Binding="{Binding Size}" Width="110"/><DataGridTextColumn Header="完整路径（双击定位）" Binding="{Binding FullPath}" Width="3*"/></DataGrid.Columns></DataGrid>
        <TextBlock x:Name="ScanErrors" Style="{StaticResource MutedText}" Margin="0,12,0,0"/>
        <Border Style="{StaticResource Card}" Margin="0,22,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,18,0"><TextBlock Text="检查文件系统" FontSize="15"/><TextBlock Text="对当前路径所在磁盘运行 Windows CHKDSK 只读检查。在独立窗口显示报告，需要管理员权限；不自动修复。" Style="{StaticResource MutedText}" Margin="0,8,0,0"/></StackPanel><Button Grid.Column="1" Content="运行只读检查 ↗" Click="CheckDisk_Click" VerticalAlignment="Center"/></Grid></Border>
      </StackPanel></ScrollViewer>
      <ScrollViewer x:Name="NetworkPage" Visibility="Collapsed"><StackPanel><TextBlock Text="网络测速" Style="{StaticResource PageHeading}"/><TextBlock Text="用真实传输了解当前连接表现。" Foreground="{StaticResource Muted}" Margin="0,0,0,24"/>
        <Border Style="{StaticResource Card}" Padding="28"><StackPanel><Grid><StackPanel><TextBlock Text="连接性能测试" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Cloudflare · HTTPS · 单连接" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button x:Name="SpeedButton" Content="开始测速" Style="{StaticResource Primary}" Click="Speed_Click"/><Button x:Name="CancelSpeedButton" Content="取消" Click="CancelSpeed_Click" IsEnabled="False" Margin="10,0,0,0"/></StackPanel></Grid>
          <UniformGrid Columns="3" Margin="0,34,0,32"><StackPanel><TextBlock Text="↓ 下载速度" Foreground="{StaticResource Muted}"/><TextBlock x:Name="SpeedDownload" Text="—" FontSize="38" Foreground="{StaticResource Accent}" Margin="0,12,0,3"/><TextBlock Text="Mbps" Style="{StaticResource MutedText}"/></StackPanel><StackPanel><TextBlock Text="↑ 上传速度" Foreground="{StaticResource Muted}"/><TextBlock x:Name="SpeedUpload" Text="—" FontSize="38" Foreground="#B6A8FF" Margin="0,12,0,3"/><TextBlock Text="Mbps" Style="{StaticResource MutedText}"/></StackPanel><StackPanel><TextBlock Text="⇄ HTTP 延迟" Foreground="{StaticResource Muted}"/><TextBlock x:Name="SpeedLatency" Text="—" FontSize="38" Foreground="#E8C98D" Margin="0,12,0,3"/><TextBlock Text="ms · 不含首次 TLS 握手" Style="{StaticResource MutedText}"/></StackPanel></UniformGrid>
          <ProgressBar x:Name="SpeedProgress"/><TextBlock x:Name="SpeedStatus" Text="准备就绪" Foreground="{StaticResource Muted}" Margin="0,15,0,0"/>
        </StackPanel></Border>
        <Border Style="{StaticResource Card}" Margin="0,20,0,0"><StackPanel><TextBlock Text="测试说明" FontSize="15"/><TextBlock Text="点击开始后会连接 speed.cloudflare.com，最多下载 32 MiB、上传 8 MiB 测试数据（另有少量探测与协议流量）。数据是生成的测试内容，不会上传本机文件。" Foreground="{StaticResource Muted}" Margin="0,12,0,10"/><TextBlock Text="结果受服务器距离、Wi-Fi、代理及同时运行的流量影响，表示本次单连接传输表现。实时网卡流量可在运行概览查看。" Style="{StaticResource MutedText}"/></StackPanel></Border>
      </StackPanel></ScrollViewer>
      <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed"><StackPanel><TextBlock Text="偏好设置" Style="{StaticResource PageHeading}"/><TextBlock Text="让 Roger 以你喜欢的方式陪伴工作。" Foreground="{StaticResource Muted}" Margin="0,0,0,24"/>
        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="桌面监控条" FontSize="17" Margin="0,0,0,10"/><CheckBox x:Name="SettingDock" Content="显示监控条"/><WrapPanel><CheckBox x:Name="SettingCpu" Content="CPU" Margin="0,8,26,8"/><CheckBox x:Name="SettingGpu" Content="GPU" Margin="0,8,26,8"/><CheckBox x:Name="SettingMemory" Content="内存" Margin="0,8,26,8"/><CheckBox x:Name="SettingNetwork" Content="网络" Margin="0,8,26,8"/></WrapPanel><CheckBox x:Name="SettingTemperature" Content="显示 CPU / GPU 温度"/><CheckBox x:Name="SettingCompact" Content="紧凑模式（隐藏温度和上传速度）"/>
        <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="显示位置" VerticalAlignment="Center"/><ComboBox x:Name="SettingPosition" Grid.Column="1" HorizontalAlignment="Left" Width="220"><ComboBoxItem Content="任务栏右侧"/><ComboBoxItem Content="任务栏左侧"/><ComboBoxItem Content="屏幕右上角"/><ComboBoxItem Content="屏幕右下角"/><ComboBoxItem Content="自由拖动"/></ComboBox></Grid>
        <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="不透明度" VerticalAlignment="Center"/><Slider x:Name="SettingOpacity" Grid.Column="1" Minimum="0.4" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Width="220" HorizontalAlignment="Left" AutomationProperties.Name="监控条不透明度"/></Grid>
        <TextBlock Text="监控条是任务栏附近的独立浮层，可能覆盖任务栏按钮；可切换到屏幕角落或自由拖动。多显示器下会跟随主窗口所在屏幕。" Style="{StaticResource MutedText}" Margin="0,18,0,0"/>
        </StackPanel></Border>
        <Border Style="{StaticResource Card}" Margin="0,18,0,0"><StackPanel><TextBlock Text="应用行为" FontSize="17" Margin="0,0,0,10"/><Grid Margin="0,8,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="采样间隔" VerticalAlignment="Center"/><ComboBox x:Name="SettingInterval" Grid.Column="1" HorizontalAlignment="Left"><ComboBoxItem Content="1 秒" Tag="1"/><ComboBoxItem Content="2 秒" Tag="2"/><ComboBoxItem Content="3 秒" Tag="3"/><ComboBoxItem Content="5 秒" Tag="5"/><ComboBoxItem Content="10 秒" Tag="10"/></ComboBox></Grid><CheckBox x:Name="SettingTray" Content="关闭主窗口时保留托盘监控"/><CheckBox x:Name="SettingStartup" Content="登录 Windows 时启动到托盘"/><CheckBox x:Name="SettingAutoUpdate" Content="启动时检查 Roger 更新（需在版本页配置仓库）"/></StackPanel></Border>
        <StackPanel Orientation="Horizontal" Margin="0,20,0,0"><Button Content="保存设置" Click="SaveSettings_Click" Style="{StaticResource Primary}"/><TextBlock x:Name="SettingsStatus" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{StaticResource Accent}"/></StackPanel>
      </StackPanel></ScrollViewer>
      <ScrollViewer x:Name="UpdatesPage" Visibility="Collapsed"><StackPanel><TextBlock Text="版本与更新" Style="{StaticResource PageHeading}"/><TextBlock Text="开源、透明，持续改进。" Foreground="{StaticResource Muted}" Margin="0,0,0,24"/>
        <Border Style="{StaticResource Card}" Padding="28"><StackPanel><TextBlock Text="Roger" FontSize="36" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/><TextBlock x:Name="VersionLabel" Text="v0.1.0 · Windows x64 · MIT License" Foreground="{StaticResource Muted}" Margin="0,8,0,26"/><TextBlock Text="GitHub 发布仓库" FontSize="16"/><TextBlock Text="输入 owner/repository，连接该仓库的正式 GitHub Releases。" Style="{StaticResource MutedText}" Margin="0,8,0,12"/><TextBox x:Name="RepositoryInput" AutomationProperties.Name="GitHub 发布仓库"/><StackPanel Orientation="Horizontal" Margin="0,16,0,18"><Button Content="保存仓库" Click="SaveRepository_Click" Margin="0,0,10,0"/><Button x:Name="CheckUpdateButton" Content="检查更新" Click="CheckUpdate_Click" Style="{StaticResource Primary}"/><Button x:Name="OpenReleaseButton" Content="查看并下载 ↗" Click="OpenRelease_Click" IsEnabled="False" Margin="10,0,0,0"/></StackPanel><TextBlock x:Name="UpdateStatus" Text="配置发布仓库后即可检查新版本。" Foreground="{StaticResource Muted}"/><TextBox x:Name="ReleaseNotes" IsReadOnly="True" TextWrapping="Wrap" MinHeight="120" MaxHeight="300" VerticalScrollBarVisibility="Auto" Margin="0,18,0,0" Text="更新说明将显示在这里。"/></StackPanel></Border>
        <TextBlock Text="更新由你主动下载替换，不会在后台覆盖正在运行的程序。发布包提供 SHA-256 校验文件。" Style="{StaticResource MutedText}" Margin="0,18,0,0"/>
      </StackPanel></ScrollViewer>
    </Grid>
    <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#11171F" BorderBrush="#27313D" BorderThickness="0,1,0,0"><Grid Margin="18,0"><TextBlock x:Name="FooterStatus" Text="● 正在连接本机传感器" Foreground="#8FA2B6" FontSize="10" VerticalAlignment="Center"/><TextBlock x:Name="FooterTime" HorizontalAlignment="Right" Foreground="#657B91" FontSize="10" VerticalAlignment="Center"/></Grid></Border>
  </Grid></Border>
</Window>

