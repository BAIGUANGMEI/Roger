<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:views="clr-namespace:Roger.Views" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Roger.MainWindow" Title="Roger · 电脑状态，一眼掌握" Icon="Assets/Roger.ico" Width="1280" Height="880" MinWidth="1080" MinHeight="720" Background="{DynamicResource Bg}" Foreground="{DynamicResource TextPrimary}" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13" TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" SnapsToDevicePixels="True" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Loaded="Window_Loaded" Closing="Window_Closing">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="56" />
      <RowDefinition Height="*" />
      <RowDefinition Height="30" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="218" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border Grid.ColumnSpan="2" Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseDown">
      <Grid Margin="20,0,8,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="{StaticResource RogerMark}" Width="29" Height="29" />
          <TextBlock Text="Roger" FontFamily="Segoe UI" FontSize="20" FontWeight="SemiBold" Margin="11,0,0,0" VerticalAlignment="Center" />
          <Border Background="{DynamicResource SurfaceRaised}" CornerRadius="4" Padding="7,3" Margin="13,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="SYSTEM MONITOR" FontFamily="Segoe UI" FontSize="9" Foreground="{DynamicResource Faint}" />
          </Border>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button x:Name="AdminButton" Click="Elevate_Click" Background="Transparent" BorderThickness="0" Padding="10,7" Margin="0,0,5,0">
            <StackPanel Orientation="Horizontal">
              <Viewbox Width="15" Height="15">
                <Canvas Width="24" Height="24">
                  <Path Data="{StaticResource IconShield}" Style="{StaticResource IconPath}" />
                </Canvas>
              </Viewbox>
              <TextBlock x:Name="AdminBadge" Text="普通权限" Margin="7,0,0,0" FontSize="11" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Click="ToggleTheme_Click" ToolTip="切换亮色 / 暗色" AutomationProperties.Name="切换主题" Style="{StaticResource CaptionButton}">
            <Viewbox Width="16" Height="16">
              <Canvas Width="24" Height="24">
                <Path x:Name="ThemeGlyph" Data="{StaticResource IconSun}" Style="{StaticResource IconPath}" />
              </Canvas>
            </Viewbox>
          </Button>
          <Border Width="1" Height="18" Background="{DynamicResource Line}" Margin="9,0" />
          <Button Click="Minimize_Click" Style="{StaticResource CaptionButton}" AutomationProperties.Name="最小化">
            <Viewbox Width="16" Height="16">
              <Canvas Width="24" Height="24">
                <Path Data="{StaticResource IconMinimize}" Style="{StaticResource IconPath}" />
              </Canvas>
            </Viewbox>
          </Button>
          <Button Click="Maximize_Click" Style="{StaticResource CaptionButton}" AutomationProperties.Name="最大化或还原">
            <Viewbox Width="14" Height="14">
              <Canvas Width="24" Height="24">
                <Path x:Name="MaximizeGlyph" Data="{StaticResource IconMaximize}" Style="{StaticResource IconPath}" />
              </Canvas>
            </Viewbox>
          </Button>
          <Button Click="Close_Click" Style="{StaticResource CloseCaption}" AutomationProperties.Name="关闭" ToolTip="关闭到托盘，可在偏好设置中调整">
            <Viewbox Width="17" Height="17">
              <Canvas Width="24" Height="24">
                <Path Data="{StaticResource IconClose}" Style="{StaticResource IconPath}" />
              </Canvas>
            </Viewbox>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
    <Border Grid.Row="1" Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,24,0,0">
          <TextBlock Text="监控与工具" Foreground="{DynamicResource Faint}" FontSize="10" Margin="28,0,0,13" />
          <RadioButton x:Name="NavOverview" Tag="overview" GroupName="Nav" Style="{StaticResource Nav}" Checked="Navigate_Checked" IsChecked="True" AutomationProperties.Name="运行概览">
            <StackPanel Orientation="Horizontal">
              <Viewbox Width="18" Height="18">
                <Canvas Width="24" Height="24">
                  <Path Data="{StaticResource IconOverview}" Style="{StaticResource IconPath}" />
                </Canvas>
              </Viewbox>
              <TextBlock Text="运行概览" Margin="13,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </RadioButton>
          <RadioButton Tag="hardware" GroupName="Nav" Style="{StaticResource Nav}" Checked="Navigate_Checked" AutomationProperties.Name="硬件与传感器">
            <StackPanel Orientation="Horizontal">
              <Viewbox Width="18" Height="18">
                <Canvas Width="24" Height="24">
                  <Path Data="{StaticResource IconHardware}" Style="{StaticResource IconPath}" />
                </Canvas>
              </Viewbox>
              <TextBlock Text="硬件与传感器" Margin="13,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </RadioButton>
          <RadioButton Tag="disk" GroupName="Nav" Style="{StaticResource Nav}" Checked="Navigate_Checked" AutomationProperties.Name="磁盘空间">
            <StackPanel Orientation="Horizontal">
              <Viewbox Width="18" Height="18">
                <Canvas Width="24" Height="24">
                  <Path Data="{StaticResource IconDisk}" Style="{StaticResource IconPath}" />
                </Canvas>
              </Viewbox>
              <TextBlock Text="磁盘空间" Margin="13,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavFileSystem" Tag="filesystem" GroupName="Nav" Style="{StaticResource Nav}" Checked="Navigate_Checked" AutomationProperties.Name="文件系统检查">
            <StackPanel Orientation="Horizontal">
              <Viewbox Width="18" Height="18">
                <Canvas Width="24" Height="24">
                  <Path Data="{StaticResource IconScan}" Style="{StaticResource IconPath}" />
                </Canvas>
              </Viewbox>
              <TextBlock Text="文件系统检查" Margin="13,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </RadioButton>
          <RadioButton Tag="network" GroupName="Nav" Style="{StaticResource Nav}" Checked="Navigate_Checked" AutomationProperties.Name="网络测速">
            <StackPanel Orientation="Horizontal">
              <Viewbox Width="18" Height="18">
                <Canvas Width="24" Height="24">
                  <Path Data="{StaticResource IconNetwork}" Style="{StaticResource IconPath}" />
                </Canvas>
              </Viewbox>
              <TextBlock Text="网络测速" Margin="13,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </RadioButton>
          <Border Height="1" Background="{DynamicResource Line}" Margin="26,18" />
          <RadioButton Tag="settings" GroupName="Nav" Style="{StaticResource Nav}" Checked="Navigate_Checked" AutomationProperties.Name="偏好设置">
            <StackPanel Orientation="Horizontal">
              <Viewbox Width="18" Height="18">
                <Canvas Width="24" Height="24">
                  <Path Data="{StaticResource IconSettings}" Style="{StaticResource IconPath}" />
                </Canvas>
              </Viewbox>
              <TextBlock Text="偏好设置" Margin="13,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </RadioButton>
          <RadioButton Tag="updates" GroupName="Nav" Style="{StaticResource Nav}" Checked="Navigate_Checked" AutomationProperties.Name="版本与更新">
            <StackPanel Orientation="Horizontal">
              <Viewbox Width="18" Height="18">
                <Canvas Width="24" Height="24">
                  <Path Data="{StaticResource IconUpdates}" Style="{StaticResource IconPath}" />
                </Canvas>
              </Viewbox>
              <TextBlock Text="版本与更新" Margin="13,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </RadioButton>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="22,0,22,22">
          <Border Background="{DynamicResource AccentSoft}" CornerRadius="10" Padding="13">
            <StackPanel>
              <TextBlock Text="●  监控运行中" Foreground="{DynamicResource Accent}" FontSize="12" />
              <TextBlock x:Name="SidebarInterval" Text="每2秒采样" Style="{StaticResource MutedText}" Margin="0,7,0,0" />
            </StackPanel>
          </Border>
          <TextBlock x:Name="SidebarVersion" Text="ROGER / v0.2.0" FontFamily="Segoe UI" FontSize="10" Foreground="{DynamicResource Faint}" Margin="2,18,0,0" />
        </StackPanel>
        <Grid />
      </DockPanel>
    </Border>
    <Grid Grid.Row="1" Grid.Column="1" Margin="28,24,18,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="78" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid Margin="0,0,12,0">
        <StackPanel>
          <TextBlock x:Name="PageTitle" Text="运行概览" FontSize="25" FontWeight="SemiBold" />
          <TextBlock x:Name="PageSubtitle" Text="一览处理器、显卡、内存与网络的实时表现。" Foreground="{DynamicResource Muted}" Margin="0,9,0,0" FontSize="12" />
        </StackPanel>
        <Border Background="{DynamicResource AccentSoft}" CornerRadius="13" Padding="11,5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,0,0">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="5" Height="5" Fill="{DynamicResource Accent}" Margin="0,0,7,0" VerticalAlignment="Center" />
            <TextBlock Text="本机实时" Foreground="{DynamicResource Accent}" FontSize="10" />
          </StackPanel>
        </Border>
      </Grid>
      <Grid Grid.Row="1">
        <ScrollViewer x:Name="OverviewPage" Padding="0,0,12,8">
          <StackPanel>
            <UniformGrid Columns="4" Margin="-5,0,-5,18">
              <Border Style="{StaticResource Card}" Margin="5,0">
                <StackPanel>
                  <TextBlock Text="CPU / 处理器" Foreground="{DynamicResource Muted}" FontSize="11" />
                  <TextBlock x:Name="CpuValue" Text="—" FontSize="34" FontWeight="SemiBold" Margin="0,12,0,9" Foreground="{DynamicResource Accent}" />
                  <ProgressBar x:Name="CpuProgress" />
                  <TextBlock x:Name="CpuDetail" Text="温度 等待采样" Style="{StaticResource MutedText}" Margin="0,13,0,0" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}" Margin="5,0">
                <StackPanel>
                  <TextBlock Text="GPU / 图形处理器" Foreground="{DynamicResource Muted}" FontSize="11" />
                  <TextBlock x:Name="GpuValue" Text="—" FontSize="34" FontWeight="SemiBold" Margin="0,12,0,9" Foreground="{DynamicResource GpuAccent}" />
                  <ProgressBar x:Name="GpuProgress" Foreground="{DynamicResource GpuAccent}" />
                  <TextBlock x:Name="GpuDetail" Text="温度 等待采样" Style="{StaticResource MutedText}" Margin="0,13,0,0" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}" Margin="5,0">
                <StackPanel>
                  <TextBlock Text="RAM / 内存" Foreground="{DynamicResource Muted}" FontSize="11" />
                  <TextBlock x:Name="MemoryValue" Text="—" FontSize="34" FontWeight="SemiBold" Margin="0,12,0,9" Foreground="{DynamicResource MemoryAccent}" />
                  <ProgressBar x:Name="MemoryProgress" Foreground="{DynamicResource MemoryAccent}" />
                  <TextBlock x:Name="MemoryDetail" Text="等待采样" Style="{StaticResource MutedText}" Margin="0,13,0,0" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}" Margin="5,0">
                <StackPanel>
                  <TextBlock Text="NETWORK / 当前流量" Foreground="{DynamicResource Muted}" FontSize="11" />
                  <TextBlock x:Name="DownloadValue" Text="—" FontSize="25" FontWeight="SemiBold" Margin="0,17,0,12" Foreground="{DynamicResource NetworkAccent}" />
                  <TextBlock x:Name="UploadValue" Text="↑ 等待采样" Foreground="{DynamicResource NetworkAccent}" FontSize="12" />
                  <TextBlock x:Name="NetworkDetail" Text="本机活动网卡" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" MaxHeight="18" Margin="0,13,0,0" />
                </StackPanel>
              </Border>
            </UniformGrid>
            <Grid Margin="0,0,0,18">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.65*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <Grid>
                    <TextBlock Text="性能趋势" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock x:Name="ChartSpan" Text="最近 60 次采样 · %" HorizontalAlignment="Right" Style="{StaticResource MutedText}" />
                  </Grid>
                  <views:HistoryChart x:Name="PerformanceChart" Height="156" Margin="0,20,0,10" />
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="● CPU" Foreground="{DynamicResource Accent}" FontSize="11" Margin="0,0,20,0" />
                    <TextBlock Text="● GPU" Foreground="{DynamicResource GpuAccent}" FontSize="11" Margin="0,0,20,0" />
                    <TextBlock Text="● 内存" Foreground="{DynamicResource MemoryAccent}" FontSize="11" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="设备概况" FontSize="15" FontWeight="SemiBold" />
                  <TextBlock x:Name="MachineName" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,7" />
                  <TextBlock x:Name="MachineOs" Style="{StaticResource MutedText}" />
                  <Border Height="1" Background="{DynamicResource Line}" Margin="0,15" />
                  <TextBlock Text="处理器" FontSize="10" Foreground="{DynamicResource Muted}" />
                  <TextBlock x:Name="CpuName" Text="正在识别硬件…" FontSize="12" Margin="0,5,0,11" />
                  <TextBlock Text="显卡" FontSize="10" Foreground="{DynamicResource Muted}" />
                  <TextBlock x:Name="GpuName" Text="正在识别硬件…" FontSize="12" Margin="0,5,0,0" />
                </StackPanel>
              </Border>
            </Grid>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <Grid>
                  <TextBlock Text="本地存储" FontSize="15" FontWeight="SemiBold" />
                  <TextBlock Text="已用 / 总容量" HorizontalAlignment="Right" Style="{StaticResource MutedText}" />
                </Grid>
                <StackPanel x:Name="DriveCards" Margin="0,10,0,0" />
              </StackPanel>
            </Border>
            <TextBlock x:Name="SensorNotice" Text="正在初始化传感器…" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,14,0,0" />
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="HardwarePage" Visibility="Collapsed" Padding="0,0,12,8">
          <StackPanel>
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,20,0">
                  <TextBlock Text="CPU 温度与硬件访问" Style="{StaticResource SectionTitle}" />
                  <TextBlock x:Name="HardwareAccessText" Foreground="{DynamicResource Muted}" Margin="0,8,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button x:Name="InstallDriverButton" Content="安装官方温度驱动" Click="InstallDriver_Click" Margin="0,0,8,0" />
                  <Button Content="以管理员身份重启" Click="Elevate_Click" Style="{StaticResource Primary}" />
                </StackPanel>
              </Grid>
            </Border>
            <TextBlock Text="设备配置" FontSize="16" Margin="0,0,0,12" FontWeight="SemiBold" />
            <DataGrid x:Name="HardwareGrid" Height="260" EnableRowVirtualization="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="类型" Binding="{Binding Category}" Width="100" />
                <DataGridTextColumn Header="设备" Binding="{Binding Name}" Width="2*" />
                <DataGridTextColumn Header="详细信息" Binding="{Binding Details}" Width="2*" />
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="实时传感器" FontSize="16" Margin="0,26,0,12" FontWeight="SemiBold" />
            <DataGrid x:Name="SensorGrid" Height="290" EnableRowVirtualization="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="硬件" Binding="{Binding Hardware}" Width="2*" />
                <DataGridTextColumn Header="传感器" Binding="{Binding Name}" Width="2*" />
                <DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="*" />
                <DataGridTextColumn Header="值" Binding="{Binding Value, StringFormat=F1}" Width="80" />
                <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="65" />
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="部分温度、主板与风扇传感器需要以管理员身份启动；支持程度取决于硬件和驱动。" Style="{StaticResource MutedText}" Margin="0,16,0,0" />
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="DiskPage" Visibility="Collapsed" Padding="0,0,12,8">
          <StackPanel>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBox x:Name="ScanPath" AutomationProperties.Name="扫描路径" />
                  <Button Grid.Column="1" Content="选择文件夹" Click="ChooseFolder_Click" Margin="8,0" />
                  <Button x:Name="ScanButton" Grid.Column="2" Content="开始分析" Style="{StaticResource Primary}" Click="Scan_Click" />
                  <Button x:Name="CancelScanButton" Grid.Column="3" Content="取消" Click="CancelScan_Click" IsEnabled="False" Margin="8,0,0,0" />
                </Grid>
                <ProgressBar x:Name="ScanProgress" Margin="0,17,0,12" />
                <TextBlock x:Name="ScanStatus" Text="选择文件夹或输入磁盘路径，例如 C:\。" Foreground="{DynamicResource Muted}" />
                <TextBlock x:Name="ScanCurrent" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" MaxHeight="18" />
              </StackPanel>
            </Border>
            <TextBlock Text="空间分布 / 一级目录" FontSize="16" Margin="0,24,0,12" FontWeight="SemiBold" />
            <StackPanel x:Name="DiskBars" />
            <TextBlock Text="大文件 / TOP 100" FontSize="16" Margin="0,24,0,12" FontWeight="SemiBold" />
            <DataGrid x:Name="FilesGrid" Height="235" MouseDoubleClick="FilesGrid_DoubleClick" EnableRowVirtualization="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="文件名" Binding="{Binding Name}" Width="2*" />
                <DataGridTextColumn Header="大小" Binding="{Binding Size}" Width="110" />
                <DataGridTextColumn Header="完整路径（双击定位）" Binding="{Binding FullPath}" Width="3*" />
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="ScanErrors" Style="{StaticResource MutedText}" Margin="0,12,0,0" />
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="NetworkPage" Visibility="Collapsed" Padding="0,0,12,8">
          <StackPanel>
            <Border Style="{StaticResource Card}" Padding="28">
              <StackPanel>
                <Grid>
                  <StackPanel>
                    <TextBlock Text="连接性能测试" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Cloudflare · HTTPS · 单连接" Foreground="{DynamicResource Muted}" Margin="0,8,0,0" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="SpeedButton" Content="开始测速" Style="{StaticResource Primary}" Click="Speed_Click" />
                    <Button x:Name="CancelSpeedButton" Content="取消" Click="CancelSpeed_Click" IsEnabled="False" Margin="10,0,0,0" />
                  </StackPanel>
                </Grid>
                <UniformGrid Columns="3" Margin="0,34,0,32">
                  <StackPanel>
                    <TextBlock Text="↓ 下载速度" Foreground="{DynamicResource Muted}" />
                    <TextBlock x:Name="SpeedDownload" Text="—" FontSize="38" Foreground="{DynamicResource Accent}" Margin="0,12,0,3" />
                    <TextBlock Text="Mbps" Style="{StaticResource MutedText}" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="↑ 上传速度" Foreground="{DynamicResource Muted}" />
                    <TextBlock x:Name="SpeedUpload" Text="—" FontSize="38" Foreground="{DynamicResource GpuAccent}" Margin="0,12,0,3" />
                    <TextBlock Text="Mbps" Style="{StaticResource MutedText}" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="⇄ HTTP 延迟" Foreground="{DynamicResource Muted}" />
                    <TextBlock x:Name="SpeedLatency" Text="—" FontSize="38" Foreground="{DynamicResource NetworkAccent}" Margin="0,12,0,3" />
                    <TextBlock Text="ms · 不含首次 TLS 握手" Style="{StaticResource MutedText}" />
                  </StackPanel>
                </UniformGrid>
                <ProgressBar x:Name="SpeedProgress" />
                <TextBlock x:Name="SpeedStatus" Text="准备就绪" Foreground="{DynamicResource Muted}" Margin="0,15,0,0" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,20,0,0">
              <StackPanel>
                <TextBlock Text="测试说明" FontSize="15" />
                <TextBlock Text="点击开始后会连接 speed.cloudflare.com，最多下载 32 MiB、上传 8 MiB 测试数据（另有少量探测与协议流量）。数据是生成的测试内容，不会上传本机文件。" Foreground="{DynamicResource Muted}" Margin="0,12,0,10" />
                <TextBlock Text="结果受服务器距离、Wi-Fi、代理及同时运行的流量影响，表示本次单连接传输表现。实时网卡流量可在运行概览查看。" Style="{StaticResource MutedText}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" Padding="0,0,12,8">
          <StackPanel>
            <Border Style="{StaticResource Card}" Margin="0,0,0,18">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="界面外观" Style="{StaticResource SectionTitle}" />
                  <TextBlock Text="即时切换，监控条和图表也会一起变化。" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                </StackPanel>
                <ComboBox x:Name="SettingTheme" Grid.Column="1" VerticalAlignment="Center" Width="220" SelectionChanged="Theme_SelectionChanged">
                  <ComboBoxItem Content="暗色" />
                  <ComboBoxItem Content="亮色" />
                  <ComboBoxItem Content="跟随系统" />
                </ComboBox>
              </Grid>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="桌面监控条" FontSize="17" Margin="0,0,0,10" FontWeight="SemiBold" />
                <CheckBox x:Name="SettingDock" Content="显示监控条" />
                <WrapPanel>
                  <CheckBox x:Name="SettingCpu" Content="CPU" Margin="0,8,26,8" />
                  <CheckBox x:Name="SettingGpu" Content="GPU" Margin="0,8,26,8" />
                  <CheckBox x:Name="SettingMemory" Content="内存" Margin="0,8,26,8" />
                  <CheckBox x:Name="SettingNetwork" Content="网络" Margin="0,8,26,8" />
                </WrapPanel>
                <CheckBox x:Name="SettingTemperature" Content="显示 CPU / GPU 温度" />
                <CheckBox x:Name="SettingCompact" Content="紧凑模式（隐藏温度和上传速度）" />
                <Grid Margin="0,18,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="显示位置" VerticalAlignment="Center" />
                  <ComboBox x:Name="SettingPosition" Grid.Column="1" HorizontalAlignment="Left" Width="220">
                    <ComboBoxItem Content="任务栏右侧" />
                    <ComboBoxItem Content="任务栏左侧" />
                    <ComboBoxItem Content="屏幕右上角" />
                    <ComboBoxItem Content="屏幕右下角" />
                    <ComboBoxItem Content="自由拖动" />
                  </ComboBox>
                </Grid>
                <Grid Margin="0,18,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="不透明度" VerticalAlignment="Center" />
                  <Slider x:Name="SettingOpacity" Grid.Column="1" Minimum="0.4" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Width="220" HorizontalAlignment="Left" AutomationProperties.Name="监控条不透明度" />
                </Grid>
                <TextBlock Text="监控条是任务栏附近的独立浮层，可能覆盖任务栏按钮；可切换到屏幕角落或自由拖动。多显示器下会跟随主窗口所在屏幕。" Style="{StaticResource MutedText}" Margin="0,18,0,0" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
              <StackPanel>
                <TextBlock Text="应用行为" FontSize="17" Margin="0,0,0,10" FontWeight="SemiBold" />
                <Grid Margin="0,8,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="采样间隔" VerticalAlignment="Center" />
                  <ComboBox x:Name="SettingInterval" Grid.Column="1" HorizontalAlignment="Left">
                    <ComboBoxItem Content="1 秒" Tag="1" />
                    <ComboBoxItem Content="2 秒" Tag="2" />
                    <ComboBoxItem Content="3 秒" Tag="3" />
                    <ComboBoxItem Content="5 秒" Tag="5" />
                    <ComboBoxItem Content="10 秒" Tag="10" />
                  </ComboBox>
                </Grid>
                <CheckBox x:Name="SettingTray" Content="关闭主窗口时保留托盘监控" />
                <CheckBox x:Name="SettingStartup" Content="登录 Windows 时启动到托盘" />
                <CheckBox x:Name="SettingAutoUpdate" Content="启动时检查 Roger 更新（需在版本页配置仓库）" />
              </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
              <Button Content="保存设置" Click="SaveSettings_Click" Style="{StaticResource Primary}" />
              <TextBlock x:Name="SettingsStatus" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{DynamicResource Accent}" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="UpdatesPage" Visibility="Collapsed" Padding="0,0,12,8">
          <StackPanel>
            <Border Style="{StaticResource Card}" Padding="28">
              <StackPanel>
                <TextBlock Text="Roger" FontSize="36" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" />
                <TextBlock x:Name="VersionLabel" Text="v0.2.0 · Windows x64 · MIT License" Foreground="{DynamicResource Muted}" Margin="0,8,0,26" />
                <TextBlock Text="GitHub 发布仓库" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="输入 owner/repository，连接该仓库的正式 GitHub Releases。" Style="{StaticResource MutedText}" Margin="0,8,0,12" />
                <TextBox x:Name="RepositoryInput" AutomationProperties.Name="GitHub 发布仓库" />
                <StackPanel Orientation="Horizontal" Margin="0,16,0,18">
                  <Button Content="保存仓库" Click="SaveRepository_Click" Margin="0,0,10,0" />
                  <Button x:Name="CheckUpdateButton" Content="检查更新" Click="CheckUpdate_Click" Style="{StaticResource Primary}" />
                  <Button x:Name="OpenReleaseButton" Content="查看并下载 ↗" Click="OpenRelease_Click" IsEnabled="False" Margin="10,0,0,0" />
                </StackPanel>
                <TextBlock x:Name="UpdateStatus" Text="配置发布仓库后即可检查新版本。" Foreground="{DynamicResource Muted}" />
                <TextBox x:Name="ReleaseNotes" IsReadOnly="True" VerticalContentAlignment="Top" TextWrapping="Wrap" MinHeight="120" MaxHeight="300" VerticalScrollBarVisibility="Auto" Margin="0,18,0,0" Text="更新说明将显示在这里。" />
              </StackPanel>
            </Border>
            <TextBlock Text="更新由你主动下载替换，不会在后台覆盖正在运行的程序。发布包提供 SHA-256 校验文件。" Style="{StaticResource MutedText}" Margin="0,18,0,0" />
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="FileSystemPage" Visibility="Collapsed" Padding="0,0,12,8">
          <StackPanel>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="文件系统检查" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="只读检查本地磁盘，实时报告显示在 Roger 内。" Style="{StaticResource MutedText}" Margin="0,9,0,20" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBox x:Name="CheckVolume" Text="C:\" AutomationProperties.Name="检查的磁盘或路径" />
                  <Button x:Name="CheckDiskButton" Grid.Column="1" Content="开始只读检查" Click="CheckDisk_Click" Style="{StaticResource Primary}" Margin="10,0,0,0" />
                  <Button x:Name="CancelCheckDiskButton" Grid.Column="2" Content="取消" Click="CancelCheckDisk_Click" IsEnabled="False" Margin="10,0,0,0" />
                </Grid>
                <ProgressBar x:Name="CheckDiskProgress" Margin="0,18,0,13" />
                <TextBlock x:Name="CheckDiskStatus" Text="准备就绪。需要管理员权限，可使用窗口右上角的权限按钮重启。" Foreground="{DynamicResource Muted}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
              <StackPanel>
                <Grid>
                  <TextBlock Text="检查报告" Style="{StaticResource SectionTitle}" />
                  <TextBlock Text="CHKDSK · 只读" Style="{StaticResource MutedText}" HorizontalAlignment="Right" />
                </Grid>
                <TextBox x:Name="CheckDiskReport" IsReadOnly="True" VerticalContentAlignment="Top" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap" Height="350" VerticalScrollBarVisibility="Auto" Margin="0,17,0,0" Text="检查开始后，结果将在此显示。" />
              </StackPanel>
            </Border>
            <TextBlock Text="检查不会修复文件系统、卸载磁盘或安排重启。活动卷正在写入时，部分结果需要在空闲时复查。" Style="{StaticResource MutedText}" Margin="0,15,0,0" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
    <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
      <Grid Margin="20,0">
        <TextBlock x:Name="FooterStatus" Text="正在连接本机传感器…" Foreground="{DynamicResource Muted}" FontSize="10" VerticalAlignment="Center" />
        <TextBlock x:Name="FooterTime" HorizontalAlignment="Right" Foreground="{DynamicResource Faint}" FontSize="10" VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</Window>
