<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:views="clr-namespace:Roger.Views" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Roger.MainWindow" Title="Roger · 电脑状态，一眼掌握" Icon="Assets/Roger.ico" Width="1280" Height="880" MinWidth="1080" MinHeight="720" Background="{DynamicResource Bg}" Foreground="{DynamicResource TextPrimary}" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13" TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" SnapsToDevicePixels="True" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Loaded="Window_Loaded" Closing="Window_Closing">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="56" />
      <RowDefinition Height="*" />
      <RowDefinition Height="30" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="218" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border Grid.ColumnSpan="2" Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseDown">
      <Grid Margin="20,0,8,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="{StaticResource RogerMark}" Width="29" Height="29" />
          <TextBlock Text="Roger" FontFamily="Segoe UI" FontSize="20" FontWeight="SemiBold" Margin="11,0,0,0" VerticalAlignment="Center" />
          <Border Background="{DynamicResource SurfaceRaised}" CornerRadius="4" Padding="7,3" Margin="13,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="SYSTEM MONITOR" FontFamily="Segoe UI" FontSize="9" Foreground="{DynamicResource Faint}" />
          </Border>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button x:Name="AdminButton" Click="Elevate_Click" Background="Transparent" BorderThickness="0" Padding="10,7" Margin="0,0,5,0">
            <StackPanel Orientation="Horizontal">
              <Viewbox Width="15" Height="15">
                <Canvas Width="24" Height="24">
                  <Path Data="{StaticResource IconShield}" Style="{StaticResource IconPath}" />
                </Canvas>
              </Viewbox>
              <TextBlock x:Name="AdminBadge" Text="普通权限" Margin="7,0,0,0" FontSize="11" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Click="ToggleTheme_Click" ToolTip="切换亮色 / 暗色" AutomationProperties.Name="切换主题" Style="{StaticResource CaptionButton}">
            <Viewbox Width="16" Height="16">
              <Canvas Width="24" Height="24">
                <Path x:Name="ThemeGlyph" Data="{StaticResource IconSun}" Style="{StaticResource IconPath}" />
              </Canvas>
            </Viewbox>
          </Button>
          <Border Width="1" Height="18" Background="{DynamicResource Line}" Margin="9,0" />
          <Button Click="Minimize_Click" Style="{StaticResource CaptionButton}" AutomationProperties.Name="最小化">
            <Viewbox Width="16" Height="16">
              <Canvas Width="24" Height="24">
                <Path Data="{StaticResource IconMinimize}" Style="{StaticResource IconPath}" />
              </Canvas>
            </Viewbox>
          </Button>
          <Button Click="Maximize_Click" Style="{StaticResource CaptionButton}" AutomationProperties.Name="最大化或还原">
            <Viewbox Width="14" Height="14">
              <Canvas Width="24" Height="24">
                <Path x:Name="MaximizeGlyph" Data="{StaticResource IconMaximize}" Style="{StaticResource IconPath}" />
              </Canvas>
            </Viewbox>
          </Button>
          <Button Click="Close_Click" Style="{StaticResource CloseCaption}" AutomationProperties.Name="关闭" ToolTip="关闭到托盘，可在偏好设置中调整">
            <Viewbox Width="17" Height="17">
              <Canvas Width="24" Height="24">
                <Path Data="{StaticResource IconClose}" Style="{StaticResource IconPath}" />
              </Canvas>
            </Viewbox>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
    <Border Grid.Row="1" Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,3,8">
          <StackPanel Margin="0,24,0,0">
            <TextBlock Text="硬件监控" Foreground="{DynamicResource Faint}" FontSize="10" Margin="28,0,0,13" />
            <RadioButton x:Name="NavOverview" Tag="overview" GroupName="Nav" Style="{StaticResource Nav}" Checked="Navigate_Checked" IsChecked="True" AutomationProperties.Name="运行概览">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="18" Height="18">
                  <Canvas Width="24" Height="24">
                    <Path Data="{StaticResource IconOverview}" Style="{StaticResource IconPath}" />
                  </Canvas>
                </Viewbox>
                <TextBlock Text="运行概览" Margin="13,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </RadioButton>
            <RadioButton Tag="hardware" GroupName="Nav" Style="{StaticResource Nav}" Checked="Navigate_Checked" AutomationProperties.Name="硬件与传感器">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="18" Height="18">
                  <Canvas Width="24" Height="24">
                    <Path Data="{StaticResource IconHardware}" Style="{StaticResource IconPath}" />
                  </Canvas>
                </Viewbox>
                <TextBlock Text="硬件与传感器" Margin="13,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="NavStorage" Tag="storage" GroupName="Nav" Style="{StaticResource Nav}" Checked="Navigate_Checked" AutomationProperties.Name="硬盘硬件">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="18" Height="18">
                  <Canvas Width="24" Height="24">
                    <Path Data="{StaticResource IconDisk}" Style="{StaticResource IconPath}" />
                  </Canvas>
                </Viewbox>
                <TextBlock Text="硬盘硬件" Margin="13,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </RadioButton>
            <RadioButton Tag="network" GroupName="Nav" Style="{StaticResource Nav}" Checked="Navigate_Checked" AutomationProperties.Name="网络测速">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="18" Height="18">
                  <Canvas Width="24" Height="24">
                    <Path Data="{StaticResource IconNetwork}" Style="{StaticResource IconPath}" />
                  </Canvas>
                </Viewbox>
                <TextBlock Text="网络测速" Margin="13,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </RadioButton>
            <RadioButton Tag="processes" GroupName="Nav" Style="{StaticResource Nav}" Checked="Navigate_Checked" AutomationProperties.Name="进程资源排行">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="{StaticResource IconHardware}" Style="{StaticResource IconPath}"/></Canvas></Viewbox>
                <TextBlock Text="进程资源排行" Margin="13,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </RadioButton>
            <RadioButton Tag="history" GroupName="Nav" Style="{StaticResource Nav}" Checked="Navigate_Checked" AutomationProperties.Name="历史监控">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="{StaticResource IconOverview}" Style="{StaticResource IconPath}"/></Canvas></Viewbox>
                <TextBlock Text="历史监控" Margin="13,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="NavAlerts" Tag="alerts" GroupName="Nav" Style="{StaticResource Nav}" Checked="Navigate_Checked" AutomationProperties.Name="异常提醒">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="{StaticResource IconShield}" Style="{StaticResource IconPath}"/></Canvas></Viewbox>
                <TextBlock Text="异常提醒" Margin="13,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </RadioButton>
            <TextBlock Text="维护工具" Foreground="{DynamicResource Faint}" FontSize="10" Margin="28,20,0,10" />
            <RadioButton Tag="disk" GroupName="Nav" Style="{StaticResource Nav}" Checked="Navigate_Checked" AutomationProperties.Name="磁盘空间">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="18" Height="18">
                  <Canvas Width="24" Height="24">
                    <Path Data="{StaticResource IconDisk}" Style="{StaticResource IconPath}" />
                  </Canvas>
                </Viewbox>
                <TextBlock Text="磁盘空间" Margin="13,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="NavFileSystem" Tag="filesystem" GroupName="Nav" Style="{StaticResource Nav}" Checked="Navigate_Checked" AutomationProperties.Name="文件系统检查">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="18" Height="18">
                  <Canvas Width="24" Height="24">
                    <Path Data="{StaticResource IconScan}" Style="{StaticResource IconPath}" />
                  </Canvas>
                </Viewbox>
                <TextBlock Text="文件系统检查" Margin="13,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="NavToolbox" Tag="toolbox" GroupName="Nav" Style="{StaticResource Nav}" Checked="Navigate_Checked" AutomationProperties.Name="优化工具箱">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="18" Height="18">
                  <Canvas Width="24" Height="24">
                    <Path Data="{StaticResource IconSettings}" Style="{StaticResource IconPath}" />
                  </Canvas>
                </Viewbox>
                <TextBlock Text="优化工具箱" Margin="13,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </RadioButton>
            <Border Height="1" Background="{DynamicResource Line}" Margin="26,18" />
            <RadioButton Tag="settings" GroupName="Nav" Style="{StaticResource Nav}" Checked="Navigate_Checked" AutomationProperties.Name="偏好设置">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="18" Height="18">
                  <Canvas Width="24" Height="24">
                    <Path Data="{StaticResource IconSettings}" Style="{StaticResource IconPath}" />
                  </Canvas>
                </Viewbox>
                <TextBlock Text="偏好设置" Margin="13,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </RadioButton>
            <RadioButton Tag="updates" GroupName="Nav" Style="{StaticResource Nav}" Checked="Navigate_Checked" AutomationProperties.Name="版本与更新">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="18" Height="18">
                  <Canvas Width="24" Height="24">
                    <Path Data="{StaticResource IconUpdates}" Style="{StaticResource IconPath}" />
                  </Canvas>
                </Viewbox>
                <TextBlock Text="版本与更新" Margin="13,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </RadioButton>
          </StackPanel>
        </ScrollViewer>
        <StackPanel Margin="22,0,22,22" Grid.Row="1">
          <Border Background="{DynamicResource AccentSoft}" CornerRadius="10" Padding="13">
            <StackPanel>
              <TextBlock Text="●  监控运行中" Foreground="{DynamicResource Accent}" FontSize="12" />
              <TextBlock x:Name="SidebarInterval" Text="每2秒采样" Style="{StaticResource MutedText}" Margin="0,7,0,0" />
            </StackPanel>
          </Border>
          <TextBlock x:Name="SidebarVersion" Text="ROGER / v0.3.0" FontFamily="Segoe UI" FontSize="10" Foreground="{DynamicResource Faint}" Margin="2,18,0,0" />
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1" Grid.Column="1" Margin="28,24,18,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="78" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid Margin="0,0,12,0">
        <StackPanel>
          <TextBlock x:Name="PageTitle" Text="运行概览" FontSize="25" FontWeight="SemiBold" />
          <TextBlock x:Name="PageSubtitle" Text="一览处理器、显卡、内存与网络的实时表现。" Foreground="{DynamicResource Muted}" Margin="0,9,0,0" FontSize="12" />
        </StackPanel>
        <Border Background="{DynamicResource AccentSoft}" CornerRadius="13" Padding="11,5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,0,0">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="5" Height="5" Fill="{DynamicResource Accent}" Margin="0,0,7,0" VerticalAlignment="Center" />
            <TextBlock Text="本机实时" Foreground="{DynamicResource Accent}" FontSize="10" />
          </StackPanel>
        </Border>
      </Grid>
      <Grid Grid.Row="1">
        <ScrollViewer x:Name="OverviewPage" Padding="0,0,12,8">
          <StackPanel>
            <UniformGrid Columns="4" Margin="-5,0,-5,18">
              <Border Style="{StaticResource Card}" Margin="5,0">
                <StackPanel>
                  <TextBlock Text="CPU / 处理器" Foreground="{DynamicResource Muted}" FontSize="11" />
                  <TextBlock x:Name="CpuValue" Text="—" FontSize="34" FontWeight="SemiBold" Margin="0,12,0,9" Foreground="{DynamicResource Accent}" />
                  <ProgressBar x:Name="CpuProgress" />
                  <TextBlock x:Name="CpuDetail" Text="温度 等待采样" Style="{StaticResource MutedText}" Margin="0,13,0,0" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}" Margin="5,0">
                <StackPanel>
                  <TextBlock Text="GPU / 图形处理器" Foreground="{DynamicResource Muted}" FontSize="11" />
                  <TextBlock x:Name="GpuValue" Text="—" FontSize="34" FontWeight="SemiBold" Margin="0,12,0,9" Foreground="{DynamicResource GpuAccent}" />
                  <ProgressBar x:Name="GpuProgress" Foreground="{DynamicResource GpuAccent}" />
                  <TextBlock x:Name="GpuDetail" Text="温度 等待采样" Style="{StaticResource MutedText}" Margin="0,13,0,0" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}" Margin="5,0">
                <StackPanel>
                  <TextBlock Text="RAM / 内存" Foreground="{DynamicResource Muted}" FontSize="11" />
                  <TextBlock x:Name="MemoryValue" Text="—" FontSize="34" FontWeight="SemiBold" Margin="0,12,0,9" Foreground="{DynamicResource MemoryAccent}" />
                  <ProgressBar x:Name="MemoryProgress" Foreground="{DynamicResource MemoryAccent}" />
                  <TextBlock x:Name="MemoryDetail" Text="等待采样" Style="{StaticResource MutedText}" Margin="0,13,0,0" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}" Margin="5,0">
                <StackPanel>
                  <TextBlock Text="NETWORK / 当前流量" Foreground="{DynamicResource Muted}" FontSize="11" />
                  <TextBlock x:Name="DownloadValue" Text="—" FontSize="25" FontWeight="SemiBold" Margin="0,17,0,12" Foreground="{DynamicResource NetworkAccent}" />
                  <TextBlock x:Name="UploadValue" Text="↑ 等待采样" Foreground="{DynamicResource NetworkAccent}" FontSize="12" />
                  <TextBlock x:Name="NetworkDetail" Text="本机活动网卡" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" MaxHeight="18" Margin="0,13,0,0" />
                </StackPanel>
              </Border>
            </UniformGrid>
            <Grid Margin="0,0,0,18">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.65*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <Grid>
                    <TextBlock Text="性能趋势" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock x:Name="ChartSpan" Text="最近 60 次采样 · %" HorizontalAlignment="Right" Style="{StaticResource MutedText}" />
                  </Grid>
                  <views:HistoryChart x:Name="PerformanceChart" Height="156" Margin="0,20,0,10" />
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="● CPU" Foreground="{DynamicResource Accent}" FontSize="11" Margin="0,0,20,0" />
                    <TextBlock Text="● GPU" Foreground="{DynamicResource GpuAccent}" FontSize="11" Margin="0,0,20,0" />
                    <TextBlock Text="● 内存" Foreground="{DynamicResource MemoryAccent}" FontSize="11" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="设备概况" FontSize="15" FontWeight="SemiBold" />
                  <TextBlock x:Name="MachineName" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,7" />
                  <TextBlock x:Name="MachineOs" Style="{StaticResource MutedText}" />
                  <Border Height="1" Background="{DynamicResource Line}" Margin="0,15" />
                  <TextBlock Text="处理器" FontSize="10" Foreground="{DynamicResource Muted}" />
                  <TextBlock x:Name="CpuName" Text="正在识别硬件…" FontSize="12" Margin="0,5,0,11" />
                  <TextBlock Text="显卡" FontSize="10" Foreground="{DynamicResource Muted}" />
                  <TextBlock x:Name="GpuName" Text="正在识别硬件…" FontSize="12" Margin="0,5,0,0" />
                </StackPanel>
              </Border>
            </Grid>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <Grid>
                  <TextBlock Text="本地存储" FontSize="15" FontWeight="SemiBold" />
                  <TextBlock Text="已用 / 总容量" HorizontalAlignment="Right" Style="{StaticResource MutedText}" />
                </Grid>
                <StackPanel x:Name="DriveCards" Margin="0,10,0,0" />
              </StackPanel>
            </Border>
            <TextBlock x:Name="SensorNotice" Text="正在初始化传感器…" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,14,0,0" />
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="HardwarePage" Visibility="Collapsed" Padding="0,0,12,8">
          <StackPanel>
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,20,0">
                  <TextBlock Text="CPU 温度与硬件访问" Style="{StaticResource SectionTitle}" />
                  <TextBlock x:Name="HardwareAccessText" Foreground="{DynamicResource Muted}" Margin="0,8,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button x:Name="InstallDriverButton" Content="安装官方温度驱动" Click="InstallDriver_Click" Margin="0,0,8,0" />
                  <Button Content="以管理员身份重启" Click="Elevate_Click" Style="{StaticResource Primary}" />
                </StackPanel>
              </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,18">
              <StackPanel>
                <TextBlock Text="CPU 实时数据" Style="{StaticResource SectionTitle}" />
                <DataGrid x:Name="CpuDevicesGrid" Height="112" Margin="0,15,0,0">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="处理器 / 品牌" Binding="{Binding Name}" Width="2*" />
                    <DataGridTextColumn Header="品牌" Binding="{Binding Vendor}" Width="90" />
                    <DataGridTextColumn Header="使用率" Binding="{Binding LoadText}" Width="80" />
                    <DataGridTextColumn Header="温度" Binding="{Binding TemperatureText}" Width="90" />
                    <DataGridTextColumn Header="来源与状态" Binding="{Binding StatusText}" Width="2*" />
                  </DataGrid.Columns>
                </DataGrid>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,18">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="GPU 与显存" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="选择概览与监控条显示的显卡，专用 GPU 内存和共享 GPU 内存分别统计。" Style="{StaticResource MutedText}" Margin="0,7,10,0" />
                  </StackPanel>
                  <ComboBox x:Name="GpuSelector" Grid.Column="1" Width="290" DisplayMemberPath="Label" SelectedValuePath="Id" SelectionChanged="GpuSelector_Changed" AutomationProperties.Name="概览使用的显卡" />
                </Grid>
                <DataGrid x:Name="GpuDevicesGrid" Height="160" Margin="0,15,0,0">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="显卡" Binding="{Binding Name}" Width="2*" />
                    <DataGridTextColumn Header="品牌" Binding="{Binding Vendor}" Width="70" />
                    <DataGridTextColumn Header="占用" Binding="{Binding LoadText}" Width="65" />
                    <DataGridTextColumn Header="温度" Binding="{Binding TemperatureText}" Width="80" />
                    <DataGridTextColumn Header="专用 GPU 内存" Binding="{Binding DedicatedText}" Width="130" />
                    <DataGridTextColumn Header="共享 GPU 内存" Binding="{Binding SharedText}" Width="130" />
                  </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="GpuDeviceStatus" Style="{StaticResource MutedText}" Margin="0,12,0,0" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,22">
              <StackPanel>
                <TextBlock Text="内存条" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="总占用由 Windows 物理内存接口读取；品牌、型号、插槽及配置速率由固件提供。" Style="{StaticResource MutedText}" Margin="0,7,0,12" />
                <DataGrid x:Name="MemoryModulesGrid" Height="160">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="插槽" Binding="{Binding Slot}" Width="90" />
                    <DataGridTextColumn Header="厂商" Binding="{Binding Manufacturer}" Width="*" />
                    <DataGridTextColumn Header="型号" Binding="{Binding PartNumber}" Width="2*" />
                    <DataGridTextColumn Header="容量" Binding="{Binding CapacityText}" Width="90" />
                    <DataGridTextColumn Header="配置 / 固件速率" Binding="{Binding SpeedText}" Width="160" />
                  </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="MemoryModuleStatus" Style="{StaticResource MutedText}" Margin="0,10,0,0" />
              </StackPanel>
            </Border>
            <TextBlock Text="设备配置" FontSize="16" Margin="0,0,0,12" FontWeight="SemiBold" />
            <DataGrid x:Name="HardwareGrid" Height="260" EnableRowVirtualization="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="类型" Binding="{Binding Category}" Width="100" />
                <DataGridTextColumn Header="设备" Binding="{Binding Name}" Width="2*" />
                <DataGridTextColumn Header="详细信息" Binding="{Binding Details}" Width="2*" />
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="实时传感器" FontSize="16" Margin="0,26,0,12" FontWeight="SemiBold" />
            <DataGrid x:Name="SensorGrid" Height="290" EnableRowVirtualization="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="硬件" Binding="{Binding Hardware}" Width="2*" />
                <DataGridTextColumn Header="传感器" Binding="{Binding Name}" Width="2*" />
                <DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="*" />
                <DataGridTextColumn Header="值" Binding="{Binding Value, StringFormat=F1}" Width="80" />
                <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="65" />
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="部分温度、主板与风扇传感器需要以管理员身份启动；支持程度取决于硬件和驱动。" Style="{StaticResource MutedText}" Margin="0,16,0,0" />
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="DiskPage" Visibility="Collapsed" Padding="0,0,12,8">
          <StackPanel>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBox x:Name="ScanPath" AutomationProperties.Name="扫描路径" />
                  <Button Grid.Column="1" Content="选择文件夹" Click="ChooseFolder_Click" Margin="8,0" />
                  <Button x:Name="ScanButton" Grid.Column="2" Content="开始分析" Style="{StaticResource Primary}" Click="Scan_Click" />
                  <Button x:Name="CancelScanButton" Grid.Column="3" Content="取消" Click="CancelScan_Click" IsEnabled="False" Margin="8,0,0,0" />
                </Grid>
                <ProgressBar x:Name="ScanProgress" Margin="0,17,0,12" />
                <TextBlock x:Name="ScanStatus" Text="选择文件夹或输入磁盘路径，例如 C:\。" Foreground="{DynamicResource Muted}" />
                <TextBlock x:Name="ScanCurrent" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" MaxHeight="18" />
              </StackPanel>
            </Border>
            <TextBlock Text="空间分布 / 一级目录" FontSize="16" Margin="0,24,0,12" FontWeight="SemiBold" />
            <StackPanel x:Name="DiskBars" />
            <TextBlock Text="大文件 / TOP 100" FontSize="16" Margin="0,24,0,12" FontWeight="SemiBold" />
            <DataGrid x:Name="FilesGrid" Height="235" MouseDoubleClick="FilesGrid_DoubleClick" EnableRowVirtualization="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="文件名" Binding="{Binding Name}" Width="2*" />
                <DataGridTextColumn Header="大小" Binding="{Binding Size}" Width="110" />
                <DataGridTextColumn Header="完整路径（双击定位）" Binding="{Binding FullPath}" Width="3*" />
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="ScanErrors" Style="{StaticResource MutedText}" Margin="0,12,0,0" />
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="NetworkPage" Visibility="Collapsed" Padding="0,0,12,8">
          <StackPanel>
            <Border Style="{StaticResource Card}" Padding="28">
              <StackPanel>
                <Grid>
                  <StackPanel>
                    <TextBlock Text="连接性能测试" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Cloudflare · HTTPS · 单连接" Foreground="{DynamicResource Muted}" Margin="0,8,0,0" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="SpeedButton" Content="开始测速" Style="{StaticResource Primary}" Click="Speed_Click" />
                    <Button x:Name="CancelSpeedButton" Content="取消" Click="CancelSpeed_Click" IsEnabled="False" Margin="10,0,0,0" />
                  </StackPanel>
                </Grid>
                <UniformGrid Columns="3" Margin="0,34,0,32">
                  <StackPanel>
                    <TextBlock Text="↓ 下载速度" Foreground="{DynamicResource Muted}" />
                    <TextBlock x:Name="SpeedDownload" Text="—" FontSize="38" Foreground="{DynamicResource Accent}" Margin="0,12,0,3" />
                    <TextBlock Text="Mbps" Style="{StaticResource MutedText}" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="↑ 上传速度" Foreground="{DynamicResource Muted}" />
                    <TextBlock x:Name="SpeedUpload" Text="—" FontSize="38" Foreground="{DynamicResource GpuAccent}" Margin="0,12,0,3" />
                    <TextBlock Text="Mbps" Style="{StaticResource MutedText}" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="⇄ HTTP 延迟" Foreground="{DynamicResource Muted}" />
                    <TextBlock x:Name="SpeedLatency" Text="—" FontSize="38" Foreground="{DynamicResource NetworkAccent}" Margin="0,12,0,3" />
                    <TextBlock Text="ms · 不含首次 TLS 握手" Style="{StaticResource MutedText}" />
                  </StackPanel>
                </UniformGrid>
                <ProgressBar x:Name="SpeedProgress" />
                <TextBlock x:Name="SpeedStatus" Text="准备就绪" Foreground="{DynamicResource Muted}" Margin="0,15,0,0" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,20,0,0">
              <StackPanel>
                <TextBlock Text="测试说明" FontSize="15" />
                <TextBlock Text="点击开始后会连接 speed.cloudflare.com，最多下载 32 MiB、上传 8 MiB 测试数据（另有少量探测与协议流量）。数据是生成的测试内容，不会上传本机文件。" Foreground="{DynamicResource Muted}" Margin="0,12,0,10" />
                <TextBlock Text="结果受服务器距离、Wi-Fi、代理及同时运行的流量影响，表示本次单连接传输表现。实时网卡流量可在运行概览查看。" Style="{StaticResource MutedText}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="AlertsPage" Visibility="Collapsed" Padding="0,0,12,8">
          <StackPanel>
            <Border Style="{StaticResource Card}" Margin="0,0,0,18">
              <StackPanel>
                <TextBlock Text="让持续异常得到提醒" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="仅在有效读数持续达到条件后记录异常。同一项目受冷却时间限制；传感器不可用时暂停判断。" Style="{StaticResource MutedText}" Margin="0,8,0,18" />
                <WrapPanel Margin="0,0,0,20">
                  <CheckBox x:Name="AlertsEnabled" Content="开启异常提醒" Margin="0,0,28,8" />
                  <CheckBox x:Name="AlertsQuiet" Content="静音，只保留记录" Margin="0,0,0,8" />
                </WrapPanel>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <StackPanel Margin="0,0,20,18"><CheckBox x:Name="AlertCpuEnabled" Content="CPU 温度上限（°C）"/><TextBox x:Name="AlertCpuThreshold" Margin="0,9,0,0" AutomationProperties.Name="CPU温度阈值"/></StackPanel>
                  <StackPanel Grid.Column="1" Margin="0,0,0,18"><CheckBox x:Name="AlertGpuEnabled" Content="GPU 温度上限（°C）"/><TextBox x:Name="AlertGpuThreshold" Margin="0,9,0,0" AutomationProperties.Name="GPU温度阈值"/></StackPanel>
                  <StackPanel Grid.Row="1" Margin="0,0,20,18"><CheckBox x:Name="AlertMemoryEnabled" Content="内存占用上限（%）"/><TextBox x:Name="AlertMemoryThreshold" Margin="0,9,0,0" AutomationProperties.Name="内存占用阈值"/></StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,18"><CheckBox x:Name="AlertDiskEnabled" Content="各卷剩余空间下限（%）"/><TextBox x:Name="AlertDiskThreshold" Margin="0,9,0,0" AutomationProperties.Name="磁盘剩余空间阈值"/></StackPanel>
                  <StackPanel Grid.Row="2" Margin="0,0,20,0"><TextBlock Text="持续时间（秒）" Style="{StaticResource MutedText}"/><TextBox x:Name="AlertDuration" Margin="0,9,0,0" AutomationProperties.Name="异常持续时间"/></StackPanel>
                  <StackPanel Grid.Row="2" Grid.Column="1"><TextBlock Text="同一项目提醒冷却（秒）" Style="{StaticResource MutedText}"/><TextBox x:Name="AlertCooldown" Margin="0,9,0,0" AutomationProperties.Name="异常提醒冷却时间"/></StackPanel>
                </Grid>
                <Button Content="保存提醒设置" Click="SaveAlerts_Click" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,20,0,0" />
                <TextBlock x:Name="AlertStatus" Style="{StaticResource MutedText}" Margin="0,14,0,0"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <Grid Margin="0,0,0,14"><TextBlock Text="最近异常记录" Style="{StaticResource SectionTitle}"/><Button Content="清空记录" Click="ClearAlerts_Click" HorizontalAlignment="Right" Padding="12,6"/></Grid>
                <DataGrid x:Name="AlertRecordsGrid" Height="300">
                  <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Message}"/></Style></DataGrid.RowStyle>
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="145"/>
                    <DataGridTextColumn Header="项目" Binding="{Binding Title}" Width="140"/>
                    <DataGridTextColumn Header="详情" Binding="{Binding Message}" Width="*"/>
                  </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="本地保留最近 500 条记录。Windows 通知的显示还取决于系统通知与免打扰设置。" Style="{StaticResource MutedText}" Margin="0,12,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="HistoryPage" Visibility="Collapsed" Padding="0,0,12,8">
          <StackPanel>
            <Border Style="{StaticResource Card}" Margin="0,0,0,18">
              <StackPanel>
                <TextBlock Text="回看电脑的运行状态" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="运行期间持续采集，按分钟汇总并保留最近七天。关闭软件的时段留空，重新启动后继续积累。" Style="{StaticResource MutedText}" Margin="0,8,0,16"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <ComboBox x:Name="HistoryRange" MinWidth="0" SelectionChanged="HistorySelection_Changed" Margin="0,0,12,0" AutomationProperties.Name="历史时间范围"><ComboBoxItem Content="最近一小时"/><ComboBoxItem Content="最近一天"/><ComboBoxItem Content="最近七天"/></ComboBox>
                  <ComboBox x:Name="HistoryMetric" MinWidth="0" Grid.Column="1" SelectionChanged="HistorySelection_Changed" Margin="0,0,12,0" AutomationProperties.Name="历史指标"><ComboBoxItem Content="使用率"/><ComboBoxItem Content="CPU / GPU 温度"/><ComboBoxItem Content="网络吞吐"/><ComboBoxItem Content="物理盘读写"/></ComboBox>
                  <ComboBox x:Name="HistoryGpu" Grid.Column="2" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="HistorySelection_Changed" AutomationProperties.Name="历史显卡设备"/>
                </Grid>
              </StackPanel>
            </Border>
            <UniformGrid Columns="3" Margin="0,0,-12,18">
              <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="18"><StackPanel><TextBlock x:Name="HistorySummaryOneTitle" Text="CPU" Style="{StaticResource MutedText}"/><TextBlock x:Name="HistorySummaryOne" Text="暂无有效读数" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource CpuAccent}" Margin="0,12,0,0"/></StackPanel></Border>
              <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="18"><StackPanel><TextBlock x:Name="HistorySummaryTwoTitle" Text="GPU" Style="{StaticResource MutedText}"/><TextBlock x:Name="HistorySummaryTwo" Text="暂无有效读数" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource GpuAccent}" Margin="0,12,0,0"/></StackPanel></Border>
              <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="18"><StackPanel><TextBlock x:Name="HistorySummaryThreeTitle" Text="内存" Style="{StaticResource MutedText}"/><TextBlock x:Name="HistorySummaryThree" Text="暂无有效读数" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource MemoryAccent}" Margin="0,12,0,0"/></StackPanel></Border>
            </UniformGrid>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="分钟趋势" Style="{StaticResource SectionTitle}"/>
                <views:HistoryTrendChart x:Name="HistoricalChart" Height="255" Margin="0,20,0,8"/>
                <StackPanel Orientation="Horizontal"><TextBlock x:Name="HistoryLegendOne" Text="● CPU" Foreground="{DynamicResource CpuAccent}" Margin="0,0,22,0"/><TextBlock x:Name="HistoryLegendTwo" Text="● GPU" Foreground="{DynamicResource GpuAccent}" Margin="0,0,22,0"/><TextBlock x:Name="HistoryLegendThree" Text="● 内存" Foreground="{DynamicResource MemoryAccent}"/></StackPanel>
                <TextBlock x:Name="HistoryStatus" Text="打开页面后读取本地历史。" Style="{StaticResource MutedText}" Margin="0,18,0,0"/>
                <WrapPanel Margin="0,18,0,0"><Button Content="刷新历史" Click="RefreshHistory_Click" Margin="0,0,12,0"/><Button x:Name="ExportHistoryButton" Content="导出七天 CSV" Click="ExportHistory_Click"/></WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

<ScrollViewer x:Name="ProcessPage" Visibility="Collapsed" Padding="0,0,12,8" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <Border Style="{StaticResource Card}" Margin="0,0,0,18">
      <StackPanel>
        <TextBlock Text="找到资源占用最多的程序" Style="{StaticResource SectionTitle}" />
        <TextBlock Text="每 2 秒更新，只读取进程状态。按 CPU、内存或 I/O 排序，支持程序名和 PID 搜索。" Style="{StaticResource MutedText}" Margin="0,8,0,17" />
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
          <TextBox x:Name="ProcessFilter" TextChanged="ProcessFilter_Changed" Margin="0,0,14,0" ToolTip="按程序名称或 PID 搜索" AutomationProperties.Name="搜索程序名称或 PID" />
          <ComboBox x:Name="ProcessSort" Grid.Column="1" DisplayMemberPath="Label" SelectionChanged="ProcessSort_Changed" AutomationProperties.Name="进程资源排序指标" />
        </Grid>
      </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock x:Name="ProcessSummary" Text="等待进程采样" Style="{StaticResource SectionTitle}" />
        <TextBlock x:Name="ProcessUpdated" Text="CPU 与 I/O 速率需要相邻两次采样。" Style="{StaticResource MutedText}" Margin="0,7,0,15" />
        <DataGrid x:Name="ProcessesGrid" Height="440" CanUserSortColumns="False" EnableRowVirtualization="True" EnableColumnVirtualization="True">
          <DataGrid.RowStyle>
            <Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Details}" /></Style>
          </DataGrid.RowStyle>
          <DataGrid.Columns>
            <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="45"/>
            <DataGridTextColumn Header="程序" Binding="{Binding Name}" Width="*" MinWidth="150"/>
            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="75"/>
            <DataGridTextColumn Header="CPU" Binding="{Binding CpuText}" Width="80"/>
            <DataGridTextColumn Header="内存工作集" Binding="{Binding MemoryText}" Width="105"/>
            <DataGridTextColumn Header="I/O 读取" Binding="{Binding ReadText}" Width="105"/>
            <DataGridTextColumn Header="I/O 写入" Binding="{Binding WriteText}" Width="105"/>
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="将鼠标停留在进程行上可查看程序路径和数据可用性。" Style="{StaticResource MutedText}" Margin="0,12,0,0" />
      </StackPanel>
    </Border>
    <TextBlock x:Name="ProcessNotice" Text="受保护的系统进程可能无法读取部分字段；缺失数据不会显示为零。" Style="{StaticResource MutedText}" Margin="0,14,0,0" />
  </StackPanel>
</ScrollViewer>

        <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" Padding="0,0,12,8">
          <StackPanel>
            <Border Style="{StaticResource Card}" Margin="0,0,0,18">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="界面外观" Style="{StaticResource SectionTitle}" />
                  <TextBlock Text="即时切换，监控条和图表也会一起变化。" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                </StackPanel>
                <ComboBox x:Name="SettingTheme" Grid.Column="1" VerticalAlignment="Center" Width="220" SelectionChanged="Theme_SelectionChanged">
                  <ComboBoxItem Content="暗色" />
                  <ComboBoxItem Content="亮色" />
                  <ComboBoxItem Content="跟随系统" />
                </ComboBox>
              </Grid>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="桌面监控条" FontSize="17" Margin="0,0,0,10" FontWeight="SemiBold" />
                <CheckBox x:Name="SettingDock" Content="显示监控条" />
                <WrapPanel>
                  <CheckBox x:Name="SettingCpu" Content="CPU" Margin="0,8,26,8" />
                  <CheckBox x:Name="SettingGpu" Content="GPU" Margin="0,8,26,8" />
                  <CheckBox x:Name="SettingMemory" Content="内存" Margin="0,8,26,8" />
                  <CheckBox x:Name="SettingNetwork" Content="网络" Margin="0,8,26,8" />
                </WrapPanel>
                <CheckBox x:Name="SettingTemperature" Content="显示 CPU / GPU 温度" />
                <CheckBox x:Name="SettingCompact" Content="紧凑模式（隐藏温度和上传速度）" />
                <Grid Margin="0,18,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="显示位置" VerticalAlignment="Center" />
                  <ComboBox x:Name="SettingPosition" Grid.Column="1" HorizontalAlignment="Left" Width="220">
                    <ComboBoxItem Content="任务栏右侧" />
                    <ComboBoxItem Content="任务栏左侧" />
                    <ComboBoxItem Content="屏幕右上角" />
                    <ComboBoxItem Content="屏幕右下角" />
                    <ComboBoxItem Content="自由拖动" />
                  </ComboBox>
                </Grid>
                <Grid Margin="0,18,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="不透明度" VerticalAlignment="Center" />
                  <Slider x:Name="SettingOpacity" Grid.Column="1" Minimum="0.4" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Width="220" HorizontalAlignment="Left" AutomationProperties.Name="监控条不透明度" />
                </Grid>
                <TextBlock Text="监控条是任务栏附近的独立浮层，可能覆盖任务栏按钮；可切换到屏幕角落或自由拖动。多显示器下会跟随主窗口所在屏幕。" Style="{StaticResource MutedText}" Margin="0,18,0,0" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
              <StackPanel>
                <TextBlock Text="应用行为" FontSize="17" Margin="0,0,0,10" FontWeight="SemiBold" />
                <Grid Margin="0,8,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="采样间隔" VerticalAlignment="Center" />
                  <ComboBox x:Name="SettingInterval" Grid.Column="1" HorizontalAlignment="Left">
                    <ComboBoxItem Content="1 秒" Tag="1" />
                    <ComboBoxItem Content="2 秒" Tag="2" />
                    <ComboBoxItem Content="3 秒" Tag="3" />
                    <ComboBoxItem Content="5 秒" Tag="5" />
                    <ComboBoxItem Content="10 秒" Tag="10" />
                  </ComboBox>
                </Grid>
                <CheckBox x:Name="SettingTray" Content="关闭主窗口时保留托盘监控" />
                <CheckBox x:Name="SettingStartup" Content="登录 Windows 时启动到托盘" />
                <CheckBox x:Name="SettingAutoUpdate" Content="启动时检查 Roger 更新（需在版本页配置仓库）" />
              </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
              <Button Content="保存设置" Click="SaveSettings_Click" Style="{StaticResource Primary}" />
              <TextBlock x:Name="SettingsStatus" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{DynamicResource Accent}" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="UpdatesPage" Visibility="Collapsed" Padding="0,0,12,8">
          <StackPanel>
            <Border Style="{StaticResource Card}" Padding="28">
              <StackPanel>
                <TextBlock Text="Roger" FontSize="36" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" />
                <TextBlock x:Name="VersionLabel" Text="v0.3.0 · Windows x64 · MIT License" Foreground="{DynamicResource Muted}" Margin="0,8,0,26" />
                <TextBlock Text="GitHub 发布仓库" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="输入 owner/repository，连接该仓库的正式 GitHub Releases。" Style="{StaticResource MutedText}" Margin="0,8,0,12" />
                <TextBox x:Name="RepositoryInput" AutomationProperties.Name="GitHub 发布仓库" />
                <StackPanel Orientation="Horizontal" Margin="0,16,0,18">
                  <Button Content="保存仓库" Click="SaveRepository_Click" Margin="0,0,10,0" />
                  <Button x:Name="CheckUpdateButton" Content="检查更新" Click="CheckUpdate_Click" Style="{StaticResource Primary}" />
                  <Button x:Name="OpenReleaseButton" Content="查看并下载 ↗" Click="OpenRelease_Click" IsEnabled="False" Margin="10,0,0,0" />
                </StackPanel>
                <TextBlock x:Name="UpdateStatus" Text="配置发布仓库后即可检查新版本。" Foreground="{DynamicResource Muted}" />
                <TextBox x:Name="ReleaseNotes" IsReadOnly="True" VerticalContentAlignment="Top" TextWrapping="Wrap" MinHeight="120" MaxHeight="300" VerticalScrollBarVisibility="Auto" Margin="0,18,0,0" Text="更新说明将显示在这里。" />
              </StackPanel>
            </Border>
            <TextBlock Text="更新由你主动下载替换，不会在后台覆盖正在运行的程序。发布包提供 SHA-256 校验文件。" Style="{StaticResource MutedText}" Margin="0,18,0,0" />
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="FileSystemPage" Visibility="Collapsed" Padding="0,0,12,8">
          <StackPanel>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="文件系统检查" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="只读检查本地磁盘，实时报告显示在 Roger 内。" Style="{StaticResource MutedText}" Margin="0,9,0,20" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBox x:Name="CheckVolume" Text="C:\" AutomationProperties.Name="检查的磁盘或路径" />
                  <Button x:Name="CheckDiskButton" Grid.Column="1" Content="开始只读检查" Click="CheckDisk_Click" Style="{StaticResource Primary}" Margin="10,0,0,0" />
                  <Button x:Name="CancelCheckDiskButton" Grid.Column="2" Content="取消" Click="CancelCheckDisk_Click" IsEnabled="False" Margin="10,0,0,0" />
                </Grid>
                <ProgressBar x:Name="CheckDiskProgress" Margin="0,18,0,13" />
                <TextBlock x:Name="CheckDiskStatus" Text="准备就绪。需要管理员权限，可使用窗口右上角的权限按钮重启。" Foreground="{DynamicResource Muted}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
              <StackPanel>
                <Grid>
                  <TextBlock Text="检查报告" Style="{StaticResource SectionTitle}" />
                  <TextBlock Text="CHKDSK · 只读" Style="{StaticResource MutedText}" HorizontalAlignment="Right" />
                </Grid>
                <TextBox x:Name="CheckDiskReport" IsReadOnly="True" VerticalContentAlignment="Top" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap" Height="350" VerticalScrollBarVisibility="Auto" Margin="0,17,0,0" Text="检查开始后，结果将在此显示。" />
              </StackPanel>
            </Border>
            <TextBlock Text="检查不会修复文件系统、卸载磁盘或安排重启。活动卷正在写入时，部分结果需要在空闲时复查。" Style="{StaticResource MutedText}" Margin="0,15,0,0" />
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="StorageHardwarePage" Visibility="Collapsed" Padding="0,0,12,8">
          <StackPanel>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,14,0">
                    <TextBlock x:Name="StorageModel" Text="正在识别物理硬盘…" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="StorageIdentity" Text="按物理设备编号关联卷与传感器。" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                  </StackPanel>
                  <ComboBox x:Name="StorageSelector" Grid.Column="1" Width="280" DisplayMemberPath="Label" SelectedValuePath="Id" SelectionChanged="StorageSelector_Changed" AutomationProperties.Name="查看的物理硬盘" />
                </Grid>
                <UniformGrid Columns="4" Margin="0,24,0,0">
                  <StackPanel>
                    <TextBlock Text="活动率" Style="{StaticResource MutedText}" />
                    <TextBlock x:Name="StorageActive" Text="—" Foreground="{DynamicResource Accent}" FontSize="30" Margin="0,8,0,10" />
                    <ProgressBar x:Name="StorageActiveBar" Margin="0,0,22,0" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="读取" Style="{StaticResource MutedText}" />
                    <TextBlock x:Name="StorageRead" Text="—" Foreground="{DynamicResource MemoryAccent}" FontSize="26" Margin="0,10,0,0" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="写入" Style="{StaticResource MutedText}" />
                    <TextBlock x:Name="StorageWrite" Text="—" Foreground="{DynamicResource GpuAccent}" FontSize="26" Margin="0,10,0,0" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="温度" Style="{StaticResource MutedText}" />
                    <TextBlock x:Name="StorageTemperature" Text="—" Foreground="{DynamicResource NetworkAccent}" FontSize="30" Margin="0,8,0,0" />
                  </StackPanel>
                </UniformGrid>
              </StackPanel>
            </Border>
            <Grid Margin="0,18,0,18">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.6*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="实时读写趋势" Style="{StaticResource SectionTitle}" />
                  <views:DiskRateChart x:Name="StorageRateChart" Height="180" Margin="0,20,0,12" />
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="● 读取" Foreground="{DynamicResource MemoryAccent}" Margin="0,0,20,0" FontSize="11" />
                    <TextBlock Text="● 写入" Foreground="{DynamicResource GpuAccent}" FontSize="11" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="设备状态" Style="{StaticResource SectionTitle}" />
                  <TextBlock Text="Windows 存储状态" Style="{StaticResource MutedText}" Margin="0,16,0,5" />
                  <TextBlock x:Name="StorageHealth" Text="等待采样" FontWeight="SemiBold" />
                  <TextBlock x:Name="StorageReliability" Text="可靠性数据等待查询" Foreground="{DynamicResource Muted}" Margin="0,13,0,0" />
                  <TextBlock x:Name="StorageResponse" Foreground="{DynamicResource Muted}" Margin="0,13,0,0" />
                  <TextBlock x:Name="StorageSource" Foreground="{DynamicResource Faint}" FontSize="10" Margin="0,13,0,0" />
                </StackPanel>
              </Border>
            </Grid>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="所有物理硬盘" Style="{StaticResource SectionTitle}" />
                <DataGrid x:Name="PhysicalDisksGrid" Height="205" Margin="0,14,0,0">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="磁盘" Binding="{Binding NumberText}" Width="65" />
                    <DataGridTextColumn Header="型号 / 厂商" Binding="{Binding Model}" Width="2*" />
                    <DataGridTextColumn Header="总线 / 介质" Binding="{Binding InterfaceText}" Width="110" />
                    <DataGridTextColumn Header="容量" Binding="{Binding SizeText}" Width="100" />
                    <DataGridTextColumn Header="活动率" Binding="{Binding ActiveText}" Width="80" />
                    <DataGridTextColumn Header="读取 / 写入" Binding="{Binding RateText}" Width="170" />
                    <DataGridTextColumn Header="卷" Binding="{Binding Volumes}" Width="90" />
                  </DataGrid.Columns>
                </DataGrid>
              </StackPanel>
            </Border>
            <TextBlock x:Name="StorageStatus" Text="读取物理设备、性能计数器与 Windows 存储可靠性信息。" Style="{StaticResource MutedText}" Margin="0,14,0,0" />
            <TextBlock Text="活动率是磁盘忙碌时间，读写速率是实际传输量；不执行写入测速。健康、温度与寿命信息以设备公开的数据为准，Windows 状态正常不代表完整 SMART 检测或硬件无故障。" Style="{StaticResource MutedText}" Margin="0,10,0,0" />
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="ToolboxPage" Visibility="Collapsed" Padding="0,0,12,8">
          <StackPanel>
            <Border Background="{DynamicResource AccentSoft}" CornerRadius="10" Padding="16" Margin="0,0,0,18">
              <TextBlock Text="先查看当前状态，再选择操作。电源与动画修改会保存到本地，可跨重启查看和恢复；系统设置入口由 Windows 显示和管理。" Foreground="{DynamicResource TextPrimary}" FontSize="12" />
            </Border>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="电源计划" Style="{StaticResource SectionTitle}" />
                  <TextBlock x:Name="PowerPlanStatus" Text="打开页面后读取当前电源计划。" Style="{StaticResource MutedText}" Margin="0,10,0,14" />
                  <ComboBox x:Name="PowerPlanPicker" DisplayMemberPath="Name" SelectedValuePath="Id" IsEnabled="False" AutomationProperties.Name="电源计划" />
                  <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button x:Name="ApplyPowerPlanButton" Content="应用计划" Click="ApplyPowerPlan_Click" Style="{StaticResource Primary}" IsEnabled="False" />
                    <Button x:Name="UndoPowerPlanButton" Content="恢复上次" Click="UndoPowerPlan_Click" Margin="9,0,0,0" IsEnabled="False" />
                  </StackPanel>
                  <TextBlock Text="只列出此电脑已有的计划。偏重性能的计划可能增加功耗与发热。" Style="{StaticResource MutedText}" Margin="0,13,0,0" />
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="界面动画" Style="{StaticResource SectionTitle}" />
                  <TextBlock x:Name="AnimationsStatus" Text="正在读取 Windows 客户区域动画状态。" Style="{StaticResource MutedText}" Margin="0,10,0,10" />
                  <CheckBox x:Name="ToolAnimationsEnabled" Content="启用 Windows 客户区域动画" IsEnabled="False" />
                  <StackPanel Orientation="Horizontal" Margin="0,13,0,0">
                    <Button x:Name="ApplyAnimationsButton" Content="应用动画设置" Click="ApplyAnimations_Click" Style="{StaticResource Primary}" IsEnabled="False" />
                    <Button x:Name="UndoAnimationsButton" Content="恢复上次" Click="UndoAnimations_Click" IsEnabled="False" Margin="9,0,0,0" />
                  </StackPanel>
                  <TextBlock Text="关闭此类动画可减少过渡效果；这是 Windows 公开的单项设置，不会关闭所有程序的动画。" Style="{StaticResource MutedText}" Margin="0,13,0,0" />
                </StackPanel>
              </Border>
            </Grid>
            <Border Style="{StaticResource Card}" Margin="0,18,0,18">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="DNS 解析缓存" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="清除本机已有的 DNS 缓存，让后续解析重新查询；不会修改 DNS 服务器或网络配置。" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                  </StackPanel>
                  <Button x:Name="FlushDnsButton" Grid.Column="1" Content="刷新 DNS 缓存" Click="FlushDns_Click" VerticalAlignment="Center" />
                  <Button x:Name="CancelDnsButton" Grid.Column="2" Content="取消" Click="CancelDns_Click" IsEnabled="False" VerticalAlignment="Center" Margin="9,0,0,0" />
                </Grid>
                <TextBox x:Name="DnsReport" Text="操作结果将显示在这里。" IsReadOnly="True" VerticalContentAlignment="Top" TextWrapping="Wrap" Height="105" VerticalScrollBarVisibility="Auto" FontSize="12" Margin="0,16,0,0" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,18">
              <StackPanel>
                <TextBlock Text="优化记录与恢复" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="保存修改前后的设置，重启后仍可恢复。选择一条记录；恢复前会核对当前值，已被其他操作更改时保留现状并提示冲突。" Style="{StaticResource MutedText}" Margin="0,8,0,14"/>
                <DataGrid x:Name="OptimizationHistoryGrid" Height="265">
                  <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Message}"/></Style></DataGrid.RowStyle>
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="时间" Binding="{Binding TimestampText}" Width="140"/>
                    <DataGridTextColumn Header="操作" Binding="{Binding Title}" Width="*" MinWidth="120"/>
                    <DataGridTextColumn Header="原值" Binding="{Binding BeforeText}" Width="120"/>
                    <DataGridTextColumn Header="目标值" Binding="{Binding AfterText}" Width="120"/>
                    <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="105"/>
                  </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="{Binding SelectedItem.Message, ElementName=OptimizationHistoryGrid}" Style="{StaticResource MutedText}" Margin="0,12,0,0"/>
                <WrapPanel Margin="0,15,0,0"><Button Content="恢复选中记录" Click="RestoreOptimizationRecord_Click" Style="{StaticResource Primary}" Margin="0,0,12,0"/><Button Content="刷新操作记录" Click="RefreshOptimizationHistory_Click"/></WrapPanel>
                <TextBlock x:Name="OptimizationJournalStatus" Style="{StaticResource MutedText}" Margin="0,14,0,0"/>
              </StackPanel>
            </Border>
            <Grid Margin="0,0,0,12">
              <TextBlock Text="Windows 维护与设置" Style="{StaticResource SectionTitle}" />
              <Button Content="刷新当前状态" Click="RefreshToolbox_Click" HorizontalAlignment="Right" Padding="12,7" />
            </Grid>
            <ItemsControl x:Name="OptimizationTools">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="2" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,10,12">
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" />
                      <TextBlock Grid.Row="1" Text="{Binding Description}" Style="{StaticResource MutedText}" Margin="0,9,0,14" />
                      <Button Grid.Row="2" Content="{Binding ActionLabel}" Tag="{Binding Id}" Click="OpenOptimizationTool_Click" HorizontalAlignment="Left" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="ToolboxStatus" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
    <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
      <Grid Margin="20,0">
        <TextBlock x:Name="FooterStatus" Text="正在连接本机传感器…" Foreground="{DynamicResource Muted}" FontSize="10" VerticalAlignment="Center" />
        <TextBlock x:Name="FooterTime" HorizontalAlignment="Right" Foreground="{DynamicResource Faint}" FontSize="10" VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</Window>
